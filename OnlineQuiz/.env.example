# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key-here

# JWT Configuration
JWT_SECRET=your-super-secret-key-minimum-32-characters-long-for-security
JWT_ISSUER=OnlineQuizAPI
JWT_AUDIENCE=OnlineQuizClient
JWT_EXPIRATION_HOURS=24

# Application Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=your-url-here

# CORS Configuration - Comma-separated list of allowed origins
# Example: https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# API Documentation (Swagger/Scalar)
# Set to "true" to enable Swagger in production (NOT RECOMMENDED for security)
# Automatically enabled in Development environment
# ENABLE_SWAGGER=false

# Biometric ESP32 Configuration
BIOMETRIC_ESP32_CONNECTION_STRING=your-connection-string
BIOMETRIC_ESP32_TIMEOUT=30000
BIOMETRIC_ESP32_RETRY_ATTEMPTS=3
